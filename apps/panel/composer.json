{
  "name": "forgepanel/setup-foundation",
  "description": "ForgePanel development setup application; not a production control panel",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*",
    "ext-session": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "ForgePanel\\": "src/"
    }
  },
  "scripts": {
    "test:domain": "php tests/run.php"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "extra": {
    "note": "Project license remains undecided. No composer.lock could be generated in the offline build environment."
  }
}
