{% extends 'base.html.twig' %}{% block body %}<h2>2. Enroll an authenticator</h2><p>Account: {{ enrollment.email }}</p><p>In your authenticator application, add a time-based token using this secret. Use 6 digits, SHA-1 and a 30-second interval.</p><p class="secret">{{ enrollment.secret }}</p><p>Never send this secret to support or paste it into logs.</p>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('setup-mfa') }}"><label>Current six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"></label><button>Confirm MFA</button></form>{% endblock %}
