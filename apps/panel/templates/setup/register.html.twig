{% extends 'base.html.twig' %}{% block body %}
<h2>1. Create the initial administrator</h2><p>Use the local setup authorization from your server terminal. It expires after 15 minutes.</p>
<form method="post" action="{{ path('setup_register') }}"><input type="hidden" name="_token" value="{{ csrf_token('setup-register') }}">
<label>Setup authorization<input type="password" name="bootstrap_token" required maxlength="43" autocomplete="off"></label>
<label>Email<input type="email" name="email" required maxlength="254" autocomplete="username"></label>
<label>New panel password<input type="password" name="password" required minlength="15" maxlength="128" autocomplete="new-password"></label>
<p>Use a unique passphrase. This is not your Linux root password.</p><button>Create account and choose MFA</button></form><p><a href="{{ path('setup_resume') }}">Resume an interrupted setup</a></p>{% endblock %}
