{% extends 'base.html.twig' %}
{% block body %}
<h2>ForgePanel administrator sign-in</h2>
<p>Sign in with your PANEL administrator credentials, not Linux root credentials.</p>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ path('admin_login') }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin-login') }}">
<label>Email <input type="email" name="email" maxlength="254" autocomplete="username" required></label>
<label>Password <input type="password" name="password" maxlength="128" autocomplete="current-password" required></label>
<label>MFA code or one-time recovery code (only if enabled)
<input type="text" name="verification" maxlength="64" inputmode="numeric" autocomplete="one-time-code"></label>
<button type="submit">Sign in</button>
</form>
<p>The initial installation remains incomplete until the server installer is independently qualified.</p>
{% endblock %}
