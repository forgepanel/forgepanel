{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgepanel:r3:kvm-image-admission:request:v1",
  "title": "ForgePanel R3 pinned QCOW2 admission request, never VM execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "image_filename",
    "image_sha256",
    "image_format",
    "vcpus",
    "memory_mib",
    "duration_seconds",
    "network_enabled",
    "host_shares_enabled",
    "privileged"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "image_filename": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.qcow2$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_format": {
      "const": "qcow2"
    },
    "vcpus": {
      "type": "integer",
      "minimum": 1
    },
    "memory_mib": {
      "type": "integer",
      "minimum": 1
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "network_enabled": {
      "const": false
    },
    "host_shares_enabled": {
      "const": false
    },
    "privileged": {
      "const": false
    }
  }
}
