{% extends 'base.html.twig' %}{% block body %}<h2>Save recovery codes</h2><p>Store these offline. They are not stored in plaintext in the database. This prototype records the codes; the permanent sign-in and recovery-code redemption flows are not yet implemented.</p><div class="codes">{% for code in codes %}<code>{{ code }}</code>{% endfor %}</div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('setup-recovery') }}"><button>I have saved the codes</button></form>{% endblock %}
